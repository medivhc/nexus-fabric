#!/bin/sh
# Nexus pre-commit gate (AGENTS.md §19 标准验证流程 / §19.1 独立 Review / §7 Protected Paths).
# Fast, local, machine-enforced checks that run before every commit:
#   1. whitespace hygiene on staged changes
#   2. cargo fmt --check (only when Rust files are staged and a workspace exists)
#   3. protected contract paths: warn + require contract marker (enforced in commit-msg)
#   4. code changes require Review Evidence with APPROVED/COMMENTED verdict
set -u

ROOT="$(git rev-parse --show-toplevel)" || { echo "[nexus-hook] not a git repository" >&2; exit 1; }
. "$ROOT/.githooks/hook-common.sh"

fail=0

# --- 1. whitespace hygiene ----------------------------------------------------
# NOTE: do not combine --check with --quiet; --quiet implies --exit-code and
# would make the exit code reflect "any staged change" instead of whitespace errors.
if ! git diff --cached --check >/dev/null 2>&1; then
  log_error "whitespace errors in staged changes:"
  git diff --cached --check
  fail=1
fi

# --- 2. formatting gate: cargo fmt --check -----------------------------------
if git diff --cached --name-only --diff-filter=ACMRD | grep -q '\.rs$' \
   && [ -f "$ROOT/Cargo.toml" ]; then
  if command -v cargo >/dev/null 2>&1; then
    if ! (cd "$ROOT" && cargo fmt --check --all >/dev/null 2>&1); then
      log_error "cargo fmt --check failed; run 'cargo fmt' before committing"
      fail=1
    fi
  else
    log_warn "cargo not found on PATH; formatting gate skipped"
  fi
fi

# --- 3. protected contract paths ---------------------------------------------
protected="$(protected_paths_touched)"
if [ -n "$protected" ]; then
  log_warn "staged changes touch protected contract paths:"
  printf '%s\n' "$protected" | sed 's/^/    /'
  log_warn "commit-msg hook requires 'contract: <hash>' or 'requirement-change: <hash>' in the body"
  log_warn "silently editing frozen expectations is forbidden (AGENTS.md §7)"
fi

# --- 4. code changes require Review Evidence ---------------------------------
# Check if staged changes include any Rust code in crates/
code_staged="$(git diff --cached --name-only --diff-filter=ACMRD -- 'crates/*.rs' | head -1 || true)"

if [ -n "$code_staged" ]; then
  # Find latest Review Evidence for this agent (fall back to any review for
  # legacy pre-namespaced evidence; multi-agent repos MUST name reviews
  # `review-<scope>-<agent>-r<n>` so one agent's review never satisfies
  # another agent's commit).
  AGENT="${NEXUS_AGENT:-}"
  if [ -n "$AGENT" ]; then
    review_dir="$(ls -1d "$ROOT/.evidence"/review-*-${AGENT}-* 2>/dev/null | sort | tail -1 || true)"
    [ -z "$review_dir" ] && review_dir="$(ls -1d "$ROOT/.evidence"/review-* 2>/dev/null | sort | tail -1 || true)"
  else
    review_dir="$(ls -1d "$ROOT/.evidence"/review-* 2>/dev/null | sort | tail -1 || true)"
  fi

  if [ -z "$review_dir" ]; then
    log_error "staged changes modify Rust code but no Review Evidence found in .evidence/"
    log_error "  Run independent Review first (see nexus-review skill, AGENTS.md §19.1)"
    fail=1
  else
    summary_json="$review_dir/summary.json"
    if [ ! -f "$summary_json" ]; then
      log_error "Review Evidence found at $review_dir but missing summary.json"
      fail=1
    else
      review_verdict="$(sed -n 's/.*"verdict"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$summary_json" | head -1)"
      case "$review_verdict" in
        APPROVED|COMMENTED)
          log_info "Review Evidence = $review_verdict ($(basename "$review_dir"))"
          ;;
        CHANGES_REQUESTED|BLOCKED|*)
          log_error "Latest Review Evidence verdict = ${review_verdict:-unknown}"
          log_error "  Review must be APPROVED or COMMENTED before committing code changes"
          log_error "  Review dir: $review_dir"
          fail=1
          ;;
      esac
    fi
  fi
fi

if [ "$fail" -ne 0 ]; then
  log_error "pre-commit gate failed"
  exit 1
fi
log_info "pre-commit gate passed"
exit 0
