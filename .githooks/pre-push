#!/bin/sh
# Nexus pre-push gate (AGENTS.md §19/§20 Evidence 与 Verdict / §7 Protected Paths).
#   1. nexus-harness verify --fast must not be FAIL/BLOCKED
#   2. STALE evidence blocks push (fresh evidence is a precondition for completion)
#   3. pushed range modifying protected contract paths must carry a contract marker
# stdin (git): <local ref> <local sha> <remote ref> <remote sha>
set -u

ROOT="$(git rev-parse --show-toplevel)" || { echo "[nexus-hook] not a git repository" >&2; exit 1; }
. "$ROOT/.githooks/hook-common.sh"

fail=0
remote_sha=""
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "0000000000000000000000000000000000000000" ] && continue
  remote_sha="$rsha"
done

# --- 1. harness verify gate ------------------------------------------------------
if command -v nexus-harness >/dev/null 2>&1; then
  out="$(nexus-harness verify --fast --json 2>&1 || true)"
  verdict="$(printf '%s' "$out" | sed -n 's/.*"verdict":"\([^"]*\)".*/\1/p')"
  case "$verdict" in
    FAIL|BLOCKED)
      log_error "nexus-harness verify --fast = $verdict; fix before pushing"
      fail=1
      ;;
    PASS)
      log_info "nexus-harness verify --fast = PASS"
      ;;
    *)
      log_warn "nexus-harness verify --fast = ${verdict:-unavailable}; not blocking (skeleton/unimplemented gate)"
      ;;
  esac
else
  log_warn "nexus-harness not on PATH; verify gate skipped"
fi

# --- 2. stale evidence scan ------------------------------------------------------
if [ -d "$ROOT/.evidence" ]; then
  stale="$(grep -rl '"verdict"[[:space:]]*:[[:space:]]*"STALE"' "$ROOT/.evidence" 2>/dev/null || true)"
  if [ -n "$stale" ]; then
    log_error "STALE evidence found; refresh with 'nexus-harness verify --full' before pushing:"
    printf '%s\n' "$stale" | sed 's/^/    /'
    fail=1
  fi
fi

# --- 3. protected changes in pushed range without contract marker -----------------
if [ -n "$remote_sha" ] && [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
  range="${remote_sha}..HEAD"
  protected="$(protected_paths_in_range "$range")"
  if [ -n "$protected" ]; then
    if ! git log --format=%B "$range" 2>/dev/null | grep -qE "$CONTRACT_MARKER_PATTERN"; then
      log_error "pushed range modifies protected contract paths without 'contract:'/'requirement-change:' marker:"
      printf '%s\n' "$protected" | sed 's/^/    /'
      fail=1
    fi
  fi
fi

if [ "$fail" -ne 0 ]; then
  log_error "pre-push gate failed"
  exit 1
fi
log_info "pre-push gate passed"
exit 0
