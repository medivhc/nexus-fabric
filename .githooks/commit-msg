#!/bin/sh
# Nexus commit-msg gate (AGENTS.md §4 任务类型 / §5 Contract Hash).
#   1. subject must be '<type>(<scope>): <summary>'
#   2. type must belong to the AGENTS.md task taxonomy
#   3. when staged changes touch protected contract paths, the body MUST carry
#      'contract: <hash>' or 'requirement-change: <hash>' (Contract Hash marker)
set -u

ROOT="$(git rev-parse --show-toplevel)" || { echo "[nexus-hook] not a git repository" >&2; exit 1; }
. "$ROOT/.githooks/hook-common.sh"

MSG_FILE="$1"
MSG="$(cat "$MSG_FILE")"
SUBJECT="$(printf '%s\n' "$MSG" | sed -n '1p')"

# --- 1+2. subject format and task type -----------------------------------------
if ! printf '%s' "$SUBJECT" | grep -qE "^($NEXUS_TASK_TYPES)(\([^)]*\))?: .+"; then
  log_error "commit subject must be '<type>(<scope>): <summary>'"
  log_error "type must be one of: $NEXUS_TASK_TYPES"
  exit 1
fi

# reject placeholder summaries (no information content)
if printf '%s' "$SUBJECT" | grep -qiE '^(wip|tmp|temp|fix|update|changes?|asdf|test|done|ok|stuff|misc|typo|minor)$'; then
  log_error "placeholder summary '$SUBJECT' rejected; write a meaningful summary"
  exit 1
fi

# --- 3. protected contract paths require a Contract Hash marker -----------------
protected="$(protected_paths_touched)"
if [ -n "$protected" ]; then
  if ! printf '%s\n' "$MSG" | grep -qE "$CONTRACT_MARKER_PATTERN"; then
    log_error "staged changes touch protected contract paths:"
    printf '%s\n' "$protected" | sed 's/^/    /'
    log_error "add a Contract Hash marker to the message body:"
    log_error "    contract: <hash>            (or requirement-change: <hash> for requirement-change tasks)"
    exit 1
  fi
fi

log_info "commit-msg gate passed"
exit 0
