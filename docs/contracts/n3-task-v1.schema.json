{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexus N3 v1 DTOs (contract, not implemented); root is SubmitTaskRequest",
  "$ref": "#/$defs/SubmitTaskRequest",
  "$defs": {
    "SnapshotRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "root_manifest_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "selection_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "snapshot_id",
        "workspace",
        "commit_id",
        "root_manifest_id",
        "manifest_sha256",
        "selection_digest",
        "file_count",
        "total_bytes"
      ]
    },
    "EnvironmentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "const": "linux"
        },
        "architecture": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "isolation": {
          "const": "container"
        },
        "network": {
          "const": "none"
        }
      },
      "required": [
        "os",
        "architecture",
        "image_digest",
        "isolation",
        "network"
      ]
    },
    "TaskLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cpu_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "storage_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "log_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "timeout_seconds",
        "cpu_millis",
        "memory_bytes",
        "storage_bytes",
        "log_bytes"
      ]
    },
    "OutputSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "required"
      ]
    },
    "SubmitTaskRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "input_snapshot": {
          "$ref": "#/$defs/SnapshotRef"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "maxLength": 32768,
            "pattern": "^[^\\u0000]*$"
          },
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768,
              "pattern": "^[^\\u0000]+$"
            }
          ]
        },
        "cwd": {
          "anyOf": [
            {
              "const": "."
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
            }
          ]
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentRequirement"
        },
        "limits": {
          "$ref": "#/$defs/TaskLimits"
        },
        "outputs": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/OutputSpec"
          }
        },
        "success_exit_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "idempotency_ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "schema_version",
        "workspace",
        "resource",
        "provider",
        "input_snapshot",
        "command",
        "cwd",
        "environment",
        "limits",
        "outputs",
        "success_exit_codes",
        "idempotency_key",
        "idempotency_ttl_seconds"
      ],
      "description": "Structural validation only. Provider authentication/authorization, snapshot ownership, canonical hashes, unique output paths, environment resolution, capacity and path safety must also be validated by the application service. Principal is derived, never caller input."
    },
    "TaskError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "reason",
        "retryable"
      ]
    },
    "AcceptedContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/SubmitTaskRequest"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "authenticated_principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environment_evidence": {
          "$ref": "#/$defs/EnvironmentRequirement"
        },
        "capacity_reservation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "accepted_at_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "idempotency_expires_at_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prepare_deadline_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "delivery_deadline_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "request",
        "request_digest",
        "authenticated_principal",
        "environment_evidence",
        "capacity_reservation_id",
        "accepted_at_unix",
        "idempotency_expires_at_unix",
        "prepare_deadline_unix",
        "delivery_deadline_unix"
      ]
    },
    "TaskExecution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "NotStarted",
            "Running",
            "Exited",
            "Stopped"
          ]
        },
        "started_at_unix": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "result_confirmed": {
          "type": "boolean"
        },
        "workload_succeeded": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "started_at_unix",
        "exit_code",
        "signal",
        "stop_reason",
        "result_confirmed",
        "workload_succeeded"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "Exited"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "integer"
              },
              "result_confirmed": {
                "const": true
              },
              "signal": {
                "type": "null"
              },
              "stop_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "exit_code": {
                "type": "null"
              },
              "workload_succeeded": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "NotStarted"
              }
            }
          },
          "then": {
            "properties": {
              "started_at_unix": {
                "type": "null"
              },
              "result_confirmed": {
                "const": false
              },
              "signal": {
                "type": "null"
              },
              "stop_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "Stopped"
              }
            }
          },
          "then": {
            "properties": {
              "result_confirmed": {
                "const": true
              },
              "stop_reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      ]
    },
    "TaskDelivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "Pending",
            "Complete",
            "Failed",
            "NotRequired"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "error"
      ]
    },
    "TaskCancellation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "None",
            "Requested",
            "Confirmed",
            "TooLate"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_at_unix": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "reason",
        "requested_at_unix"
      ]
    },
    "CancelRequestIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "const": "RequesterIntent"
        },
        "state": {
          "enum": [
            "None",
            "Queued",
            "Acknowledged",
            "Rejected"
          ]
        },
        "requested_at_unix": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "origin",
        "state",
        "requested_at_unix",
        "reason",
        "error"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "Rejected"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/TaskError"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "None"
              }
            }
          },
          "then": {
            "properties": {
              "requested_at_unix": {
                "type": "null"
              },
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "requested_at_unix": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      ]
    },
    "TaskView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "accepted_contract": {
          "$ref": "#/$defs/AcceptedContract"
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "phase": {
          "enum": [
            "Waiting",
            "Preparing",
            "Running",
            "Finalizing",
            "Finished"
          ]
        },
        "outcome": {
          "enum": [
            "Unfinished",
            "Completed",
            "Failed",
            "Cancelled"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskError"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution": {
          "$ref": "#/$defs/TaskExecution"
        },
        "delivery": {
          "$ref": "#/$defs/TaskDelivery"
        },
        "cancellation": {
          "$ref": "#/$defs/TaskCancellation"
        },
        "cancel_request": {
          "$ref": "#/$defs/CancelRequestIntent"
        },
        "observation": {
          "enum": [
            "Confirmed",
            "PendingVerification"
          ]
        },
        "last_event_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "session_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "accepted_contract",
        "contract_digest",
        "phase",
        "outcome",
        "error",
        "execution",
        "delivery",
        "cancellation",
        "cancel_request",
        "observation",
        "last_event_seq",
        "session_ids",
        "artifact_ids"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "Finished"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "Completed",
                  "Failed",
                  "Cancelled"
                ]
              },
              "execution": {
                "properties": {
                  "state": {
                    "enum": [
                      "NotStarted",
                      "Exited",
                      "Stopped"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "outcome": {
                "const": "Unfinished"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "Failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/TaskError"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "Completed"
              }
            }
          },
          "then": {
            "properties": {
              "execution": {
                "properties": {
                  "state": {
                    "const": "Exited"
                  },
                  "workload_succeeded": {
                    "const": true
                  }
                }
              },
              "delivery": {
                "properties": {
                  "state": {
                    "const": "Complete"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "Cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "execution": {
                "properties": {
                  "state": {
                    "enum": [
                      "NotStarted",
                      "Stopped"
                    ]
                  }
                }
              },
              "cancellation": {
                "properties": {
                  "state": {
                    "const": "Confirmed"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ArtifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "producer_node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "owner_principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "storage_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "created_at_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retain_until_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "publication_state": {
          "enum": [
            "Pending",
            "Published"
          ]
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "task_id",
        "snapshot_id",
        "environment_digest",
        "producer_node",
        "workspace",
        "owner_principal",
        "path",
        "size_bytes",
        "content_sha256",
        "storage_ref",
        "created_at_unix",
        "retain_until_unix",
        "publication_state"
      ]
    }
  }
}
