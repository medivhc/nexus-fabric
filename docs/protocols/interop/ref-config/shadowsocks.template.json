{
  "log": {
    "level": "debug",
    "timestamp": true,
    "output": "${RUN_DIR}/evidence/ref/shadowsocks/sing-box.log"
  },
  "inbounds": [
    {
      "type": "shadowsocks",
      "tag": "shadowsocks",
      "listen": "127.0.0.1",
      "listen_port": 26106,
      "method": "chacha20-ietf-poly1305",
      "password": "${SS_PASSWORD}"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct"
  }
}
