{
  "log": {
    "level": "debug",
    "timestamp": true,
    "output": "${RUN_DIR}/evidence/ref/trojan/sing-box.log"
  },
  "inbounds": [
    {
      "type": "trojan",
      "tag": "trojan",
      "listen": "127.0.0.1",
      "listen_port": 26105,
      "users": [
        {
          "name": "interop",
          "password": "${TROJAN_PASSWORD}"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "localhost",
        "certificate_path": "${RUN_DIR}/pki/cert.pem",
        "key_path": "${RUN_DIR}/pki/key.pem"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct"
  }
}
