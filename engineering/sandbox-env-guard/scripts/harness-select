#!/usr/bin/env python3
# ============================================================================
# harness-select — 依据环境能力矩阵筛选本次应运行的测试
# ----------------------------------------------------------------------------
# 输入：
#   --env-report PATH      env-check 产出的能力矩阵 JSON
#   --map PATH             capability 映射表 (TOML)：声明每个测试所需 capability
#   --scenarios-dir DIR    候选测试清单来源（扫描 *.toml，读取顶层 id 字段）
#                          （不传则仅基于 map 的 key 做演示）
# 输出：
#   stdout: JSON { selected:[...], skipped:[...], summary:{...} }
#   文件:   .env-report/test-plan.json （harness 直接读取此文件决定跑哪些）
# 判定规则：
#   测试所需的每个 capability.status 必须为 "ok"，否则该测试 skip；
#   skip 原因记载首个未满足的 capability（unsupported/missing/degraded/unknown）。
# ============================================================================
import json, os, sys, glob, argparse, fnmatch

try:
    import tomllib
except ImportError:  # pragma: no cover
    import tomli as tomllib


def load_toml(path):
    with open(path, "rb") as f:
        return tomllib.load(f)


def load_env_report(path):
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def discover_tests(scenarios_dir):
    """递归扫描 scenario toml，返回测试 id 列表（顶层 id 字段）。

    必须递归：真实仓库的 scenario 按类别分目录存放，例如
        scenarios/product/*.toml  scenarios/engineering/*.toml
    顶层 scenarios/ 通常没有 toml。若只扫一层会得到空清单，
    进而触发"用 map 的 pattern 冒充测试 id"的错误行为。
    """
    ids = []
    if not scenarios_dir or not os.path.isdir(scenarios_dir):
        return ids
    pattern = os.path.join(scenarios_dir, "**", "*.toml")
    for p in sorted(glob.glob(pattern, recursive=True)):
        if os.sep + ".git" + os.sep in p:
            continue
        try:
            doc = load_toml(p)
            tid = doc.get("id")
            if tid:
                ids.append(tid)
        except Exception as e:
            sys.stderr.write(f"[harness-select] WARN cannot parse {p}: {e}\n")
    return ids


def match_required(test_id, tests_map):
    """返回该测试所需 capability 列表（按 pattern 合并，顺序稳定）。"""
    required = []
    for pattern, spec in tests_map.items():
        if fnmatch.fnmatch(test_id, pattern):
            for c in spec.get("requires", []):
                if c not in required:
                    required.append(c)
    return required


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--env-report", default=".env-report/env-report.json")
    ap.add_argument("--map", default="test-capability-map.toml")
    ap.add_argument("--scenarios-dir", default=None)
    ap.add_argument("--out", default=".env-report/test-plan.json")
    args = ap.parse_args()

    env = load_env_report(args.env_report)
    caps = env.get("capabilities", {})
    tests_map = load_toml(args.map).get("tests", {})
    # 反静默降级：显式指定了 scenarios-dir 却一条都没扫到，说明路径错了。
    # 此时绝不能退回"用 map 的 pattern 当测试 id"——那会产出一份看似正常
    # （runnable>0）实则完全没覆盖真实测试、且 selected 里全是通配符的
    # test-plan，让下游 agent 基于幻觉判断。宁可失败，不可伪造。
    if args.scenarios_dir:
        candidates = discover_tests(args.scenarios_dir)
        if not candidates:
            sys.stderr.write(
                "[harness-select] BLOCKED: --scenarios-dir 下未发现任何 scenario toml\n"
                f"  path: {args.scenarios_dir}\n"
                "  常见原因：\n"
                "    1) 路径写成了顶层 scenarios/，而实际 toml 在 scenarios/<category>/*.toml；\n"
                "    2) 目录不存在或拼写错误；\n"
                "    3) toml 文件缺少顶层 id 字段。\n"
                "  守卫拒绝生成 test-plan（不静默降级为 map pattern 清单）。\n"
            )
            sys.exit(2)
        mode = "scenarios"
    else:
        # 未指定 scenario 源：演示模式，用 map 的 key 作为候选。
        # 必须显式标注 mode=demo，避免下游把 pattern 误当成真实测试 id。
        candidates = list(tests_map.keys())
        mode = "demo"
        sys.stderr.write(
            "[harness-select] WARN: 未指定 --scenarios-dir，进入 DEMO 模式；\n"
            "  selected/skipped 中的条目是 test-capability-map.toml 的 pattern，"
            "不是真实测试 id，不可用于驱动真实运行。\n"
        )

    selected, skipped = [], []
    for tid in candidates:
        required = match_required(tid, tests_map)
        if not required:
            # 未声明能力依赖 → 默认运行（保守）
            selected.append(tid)
            continue
        blocker = None
        for c in required:
            st = caps.get(c, {}).get("status", "unknown")
            if st != "ok":
                blocker = {"capability": c, "status": st,
                           "reason": caps.get(c, {}).get("reason", "")}
                break
        if blocker:
            skipped.append({"id": tid, "required": required, "blocked_by": blocker})
        else:
            selected.append(tid)

    plan = {
        "schema_version": "1",
        "generator": "sandbox-env-guard/harness-select",
        # mode 必须显式化：demo 模式下 selected 里是 pattern 而非真实测试 id，
        # 下游（agent/harness）应拒绝用 demo 产物驱动真实运行。
        "mode": mode,
        "scenarios_dir": args.scenarios_dir,
        "env_report": args.env_report,
        "selected": selected,
        "skipped": skipped,
        "summary": {
            "total": len(candidates),
            "runnable": len(selected),
            "skipped": len(skipped),
        },
    }
    os.makedirs(os.path.dirname(args.out) or ".", exist_ok=True)
    with open(args.out, "w", encoding="utf-8") as f:
        json.dump(plan, f, indent=2, ensure_ascii=False)
    print(json.dumps(plan, indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main()
